{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Resources",
            "type": "shell",
            "command": "rc.exe",
            "args": [
                "/Fo",
                "src\\resources.res",
                "resource\\resources.rc"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Compile Vertex Shader",
            "type": "shell",
            "command": "${env:ProgramFiles(x86)}/Windows Kits/10/bin/10.0.26100.0/x64/fxc.exe",
            "args": [
                "/T",
                "vs_5_0",
                "/E",
                "main",
                "/Fo",
                "VertexShader.cso",
                "Shader/VertexShader.hlsl"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Compile Pixel Shader",
            "type": "shell",
            "command": "${env:ProgramFiles(x86)}/Windows Kits/10/bin/10.0.26100.0/x64/fxc.exe",
            "args": [
                "/T",
                "ps_5_0",
                "/E",
                "main",
                "/Fo",
                "PixelShader.cso",
                "Shader/PixelShader.hlsl"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build Renderer",
            "type": "shell",
            "dependsOn": [
                "Compile Resources",
                "Compile Vertex Shader",
                "Compile Pixel Shader"
            ],
            "command": "cl.exe",
            "args": [
                "/EHsc",
                "/std:c++20",
                "/Iinclude",
                "src/Bindable/*.cpp",
                "src/Drawable/*.cpp",
                "src/*.cpp",
                "src/resources.res",
                "/link",
                "d3d11.lib",
                "dxgi.lib",
                "d3dcompiler.lib",
                "ole32.lib",
                "uuid.lib",
                "user32.lib",
                "/SUBSYSTEM:WINDOWS",
                "/OUT:src/WinMain.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ]
        }
    ]
}