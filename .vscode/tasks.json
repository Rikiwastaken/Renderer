{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Resources",
            "type": "shell",
            "command": "rc.exe",
            "args": [
                "/Fo",
                "src\\resources.res",
                "resource\\resources.rc"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Compile Shaders",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/ShaderCompiler.ps1"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build Renderer",
            "type": "shell",
            "dependsOn": [
                "Compile Resources",
                "Compile Shaders"
            ],
            "command": "cl.exe",
            "args": [
                "/EHsc",
                "/std:c++20",
                "/Iinclude",
                "src/Bindable/*.cpp",
                "src/Drawable/*.cpp",
                "src/*.cpp",
                "src/resources.res",
                "/link",
                "d3d11.lib",
                "dxgi.lib",
                "d3dcompiler.lib",
                "ole32.lib",
                "uuid.lib",
                "user32.lib",
                "/SUBSYSTEM:WINDOWS",
                "/OUT:src/WinMain.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ]
        }
    ]
}